# Base image for running thornode.
FROM alpine:3

RUN apk add --no-cache \
  bind-tools=9.16.48-r0 \
  curl=8.5.0-r0 \
  gcc=11.2.1_git20220219-r2 \
  jq=1.6-r1 \
  libffi-dev=3.4.2-r1  \
  musl-dev=1.2.3-r3 \
  openssl-dev=1.1.1w-r1 \
  protoc=3.18.1-r3 \
  py3-pip=22.1.1-r0 \
  python3-dev=3.10.14-r1 \
  && pip3 install --no-cache-dir requests==2.22.0 web3==5.29.0 retry==0.9.2
